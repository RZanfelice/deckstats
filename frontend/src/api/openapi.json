      "SimulationOptionsIn": {
        "properties": {
          "iterations": {
            "type": "integer",
            "maximum": 20000,
            "minimum": 100,
            "title": "Iterations",
            "default": 10000
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "title": "Seed",
            "description": "Mesma semente, mesmo resultado.",
            "default": 0
          },
          "on_the_play": {
            "type": "boolean",
            "title": "On The Play",
            "description": "Começa sem comprar no turno 1 (2 jogadores).",
            "default": false
          },
          "apply_mulligan": {
            "type": "boolean",
            "title": "Apply Mulligan",
            "description": "Aplica a política de mulligan à mão usada nos turnos.",
            "default": true
          },
          "free_mulligan": {
            "type": "boolean",
            "title": "Free Mulligan",
            "description": "O primeiro mulligan é grátis (Commander).",
            "default": true
          },
          "max_mulligans": {
            "type": "integer",
            "maximum": 6,
            "minimum": 0,
            "title": "Max Mulligans",
            "default": 3
          },
          "keep_min_lands": {
            "type": "integer",
            "maximum": 7,
            "minimum": 0,
            "title": "Keep Min Lands",
            "description": "Mínimo de terrenos numa mão mantível.",
            "default": 2
          },
          "keep_max_lands": {
            "type": "integer",
            "maximum": 7,
            "minimum": 0,
            "title": "Keep Max Lands",
            "description": "Máximo de terrenos numa mão mantível.",
            "default": 5
          },
          "keep_max_spell_mv": {
            "type": "integer",
            "maximum": 20,
            "minimum": 0,
            "title": "Keep Max Spell Mv",
            "description": "Uma mão mantível precisa de uma magia com MV até este valor.",
            "default": 3
          },
          "keep_policy": {
            "type": "string",
            "enum": [
              "simple",
              "castable"
            ],
            "title": "Keep Policy",
            "description": "`castable`: só conta o que dá para conjurar com os terrenos da mão; rampa castável vale como terreno extra e cantrips baratos como fração de terreno. `simple`: terrenos no intervalo e uma magia de MV baixo, sem olhar a castabilidade.",
            "default": "castable"
          },
          "keep_min_effective": {
            "type": "number",
            "maximum": 7,
            "minimum": 0,
            "title": "Keep Min Effective",
            "description": "(castable) Mínimo de terrenos efetivos: reais + rampa + fração dos cantrips.",
            "default": 2.5
          },
          "ramp_credit_cap": {
            "type": "integer",
            "maximum": 4,
            "minimum": 0,
            "title": "Ramp Credit Cap",
            "description": "(castable) Quantas rampas castáveis contam como terreno.",
            "default": 2
          },
          "cantrip_weight": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "title": "Cantrip Weight",
            "description": "(castable) Quanto de terreno vale cada cantrip (até 2).",
            "default": 0.5
          },
          "cast_ramp": {
            "type": "boolean",
            "title": "Cast Ramp",
            "description": "Conjura a rampa da mão com a mana disponível. Cada rampa conjurada vira +1 de mana genérica a partir do turno seguinte (paga custo genérico, não símbolos coloridos).",
            "default": true
          },
          "count_mdfc_lands": {
            "type": "boolean",
            "title": "Count Mdfc Lands",
            "description": "Conta MDFC com terreno atrás como terreno.",
            "default": true
          },
          "costs": {
            "items": {
              "type": "string",
              "pattern": "^(\\{[^{}]+\\})+$"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Costs",
            "description": "Custos extras a avaliar, como `{2}{U}{U}`."
          }
        },
        "type": "object",
        "title": "SimulationOptionsIn"
      },
